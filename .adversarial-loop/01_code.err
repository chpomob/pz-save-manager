@app.route("/api/shutdown", methods=["POST"])
def api_shutdown():
    """Gracefully stop the server."""
    csrf_err = _check_csrf()
    if csrf_err:
        return csrf_err
    manager = get_manager()
    if manager.running:
        manager.stop()

    def _shutdown() -> None:
        import os
        os._exit(0)

    from threading import Timer
    t = Timer(3.0, _shutdown)
    t.daemon = True
    t.start()
    return jsonify({"ok": True, "message": "Shutting down..."})


def run_gui(host: str = "127.0.0.1", port: int = 8080, saves_root: Path | None = None, backups_root: Path | None = None, open_browser: bool = True) -> None:
    import webbrowser
    url = f"http://{host}:{port}"
    if saves_root is None:
        saves_root = get_saves_root()
    if backups_root is None:
        backups_root = get_backups_root()
    # Store overrides so Flask routes can see them — without this,
    # the GUI banner would show the custom paths but every operation
    # (backup, restore, list) would silently use the defaults.
    app.config["_saves_root_override"] = saves_root
    app.config["_backups_root_override"] = backups_root
    try:
        save_count = len(list_saves(saves_root=saves_root))
    except Exception as e:
        save_count = f"error: {e!r}"
    print(f"\n  PZ Save Manager - {url}")
    print(f"  Saves dir : {saves_root} (exists={saves_root.is_dir()})")
    print(f"  Backups   : {backups_root}")
    print(f"  Found     : {save_count} save(s)")
    print(f"  Diagnostics: {url}/health\n")
    if open_browser:
        webbrowser.open(url)
    app.run(host=host, port=port, debug=False)

