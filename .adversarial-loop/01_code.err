+def _register_page_routes(flask_app: Flask) -> None:
+    flask_app.add_url_rule("/", "index", index)
+    flask_app.add_url_rule("/health", "health", health)
+    flask_app.add_url_rule(
+        "/thumb-backup/<game_mode>/<save_name>/<timestamp>",
