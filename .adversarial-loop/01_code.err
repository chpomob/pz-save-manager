-@app.route("/api/watcher/toggle", methods=["POST"])
-def api_watcher_toggle():
-    csrf_err = _check_csrf()
-    if csrf_err:
-        return csrf_err
-    manager = get_manager()
-    if manager.running:
-        manager.stop()
