-    t.daemon = True
-    t.start()
-    return jsonify({"ok": True, "message": "Shutting down..."})
+def _create_global_app() -> Flask:
+    flask_app = Flask(__name__)
+    _register_page_routes(flask_app)
+    register_api_routes(flask_app)
