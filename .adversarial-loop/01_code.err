 """Configuration management for PZ Save Manager.
 
-Config stored in ~/.pz-save-manager/config.json
+Config stored in ~/.pz-save-manager/config.json by default.
 """
 
 from __future__ import annotations
@@ -9,12 +9,14 @@
 import os
 import threading
 from pathlib import Path
+from typing import Any
 
 from .platforms import get_app_dir
 
-CONFIG_FILE = get_app_dir() / "config.json"
+CONFIG_PATH = get_app_dir() / "config.json"
+CONFIG_FILE = CONFIG_PATH
 
-DEFAULTS = {
+DEFAULTS: dict[str, Any] = {
     "backups_dir": None,
     "debounce_seconds": 5.0,
     "backup_cooldown_minutes": 1,
@@ -23,11 +25,8 @@
     "port": 8080,
 }
 
-_lock = threading.Lock()
-_cache: dict | None = None
 
-
-def _coerce(key: str, value):
+def _coerce(key: str, value: Any) -> Any:
     """Coerce a config value to its proper type. Returns None to signal clearing."""
     if key == "backups_dir" and (not value or str(value).lower() in ("none", "null")):
         return None
@@ -42,55 +41,80 @@
     return value
 
 
-def _load() -> dict:
-    global _cache
-    if _cache is not None:
-        return _cache
-    if CONFIG_FILE.is_file():
-        try:
-            _cache = json.loads(CONFIG_FILE.read_text())
-            return _cache
-        except (json.JSONDecodeError, OSError):
-            pass
-    _cache = {}
-    return _cache
+class ConfigStore:
+    """File-backed configuration store with an instance-owned cache."""
+
+    def __init__(self, path: Path = CONFIG_PATH) -> None:
+        self.path = path
+        self._lock = threading.Lock()
+        self._cache: dict[str, Any] | None = None
+
+    def _load(self) -> dict[str, Any]:
+        if self._cache is not None:
+            return self._cache
+        if self.path.is_file():
+            try:
+                loaded = json.loads(self.path.read_text(encoding="utf-8"))
+                self._cache = loaded if isinstance(loaded, dict) else {}
+                return self._cache
+            except (json.JSONDecodeError, OSError):
+                pass
+        self._cache = {}
+        return self._cache
+
+    def _save(self, data: dict[str, Any]) -> None:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = self.path.with_suffix(".tmp")
+        tmp.write_text(json.dumps(data, indent=2), encoding="utf-8")
+        os.replace(tmp, self.path)
+        self._cache = data
+
+    def get(self, key: str) -> Any:
+        """Get a config value, falling back to defaults."""
+        data = self._load()
+        if key in data:
+            return data[key]
+        return DEFAULTS.get(key)
+
+    def set(self, key: str, value: Any) -> None:
+        """Set a config value and save."""
+        with self._lock:
+            data = dict(self._load())
+            data[key] = value
+            self._save(data)
+
+    def get_all(self) -> dict[str, Any]:
+        """Return all config with defaults filled in."""
