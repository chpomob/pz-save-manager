+    host: str = "127.0.0.1",
+    port: int = 8080,
+    saves_root: Path | None = None,
+    backups_root: Path | None = None,
+    open_browser: bool = True,
+    config: ConfigStore | None = None,
+) -> None:
     import webbrowser
+
     url = f"http://{host}:{port}"
     if saves_root is None:
         saves_root = get_saves_root()
     if backups_root is None:
-        backups_root = get_backups_root()
-    # Store overrides so Flask routes can see them — without this,
-    # the GUI banner would show the custom paths but every operation
-    # (backup, restore, list) would silently use the defaults.
+        existing_store = app.config.get("config_store")
+        config_store = config or (existing_store if isinstance(existing_store, ConfigStore) else default_store)
+        backups_root = config_store.get_backups_dir() or get_backups_root()
+    app.config["config_store"] = config or app.config["config_store"]
     app.config["_saves_root_override"] = saves_root
     app.config["_backups_root_override"] = backups_root
+    app.config["manager"] = WatcherManager(config=app.config["config_store"], saves_root=saves_root, backups_root=backups_root)
     try:
         save_count = len(list_saves(saves_root=saves_root))
-    except Exception as e:
