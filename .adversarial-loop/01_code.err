-<div class="detail-item"><strong>Status</strong> {% if b.player_dead is none %}Unknown{% elif b.player_dead %}💀 Dead{% else %}🟢 Alive{% endif %}</div>
-{% if b.player %}<div class="detail-item"><strong>Player</strong> {{b.player}}</div>{% endif %}
