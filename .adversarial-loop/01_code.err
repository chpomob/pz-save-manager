<button class="btn btn-sm" style="background:var(--accent2);color:var(--text)" onclick='event.stopPropagation();renameSave({{save.game_mode|tojson}},{{save.full_name|tojson}},this)'>✏️ Rename</button>
</div>
</div>
</div>
{% endfor %}
</div>

