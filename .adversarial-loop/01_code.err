    try:
        backup = get_backup(game_mode, save_name, timestamp,
                            backups_root=_backups_root())
        thumb = backup.path / "thumb.png"
        if thumb.is_file():
            return send_file(thumb, mimetype="image/png")
    except Exception:
        pass
    return "", 404


