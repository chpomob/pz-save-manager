import json
from pathlib import Path
responses = [
  {
    \"finding\": 1,
    \"status\": \"fixed\",
    \"explanation\": \"The reviewer was right. The extracted template is now declared as package data and Flask resolves it through its template loader. I also verified both built artifacts contain pz_save_manager/templates/index.html.\",
    \"diff\": \""'```diff'"\\n--- a/pyproject.toml\\n+++ b/pyproject.toml\\n@@\\n [tool.setuptools.packages.find]\\n where = [\\\"src\\\"]\\n+\\n+[tool.setuptools.package-data]\\n+pz_save_manager = [\\\"templates/*.html\\\"]\\n"'```'"\\n"'```diff'"\\n--- a/src/pz_save_manager/gui.py\\n+++ b/src/pz_save_manager/gui.py\\n@@\\n-from flask import Flask, current_app, render_template_string, send_file\\n+from flask import Flask, abort, current_app, render_template, request, send_file\\n@@\\n-TEMPLATE_PATH = Path(__file__).parent / \\\"templates\\\" / \\\"index.html\\\"\\n@@\\n-    template = TEMPLATE_PATH.read_text(encoding=\\\"utf-8\\\")\\n-    return render_template_string(template, ...)\\n+    return render_template(\\\"index.html\\\", ...)\\n@@\\n-    flask_app = Flask(__name__)\\n+    flask_app = Flask(__name__, template_folder=\\\"templates\\\")\\n"'```"
  },
  {
    "finding": 2,
    "status": "fixed",
    "explanation": "The reviewer was right. The '"'/' route no longer reads and recompiles the template on every request; render_template uses Flask/Jinja's loader and cache.\",
    \"diff\": \""'```diff'"\\n--- a/src/pz_save_manager/gui.py\\n+++ b/src/pz_save_manager/gui.py\\n@@\\n-from flask import Flask, current_app, render_template_string, send_file\\n+from flask import Flask, abort, current_app, render_template, request, send_file\\n@@\\n-    template = TEMPLATE_PATH.read_text(encoding=\\\"utf-8\\\")\\n-    return render_template_string(\\n-        template,\\n+    return render_template(\\n+        \\\"index.html\\\",\\n         saves=saves,\\n         all_backups=all_backups,\\n"'```"
  },
  {
    "finding": 3,
