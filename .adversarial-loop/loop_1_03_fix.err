diff --git a/src/pz_save_manager/watcher.py b/src/pz_save_manager/watcher.py
index 6eb92282a9cd53b420b41608ced48b5a0a984a84..64bf5d6fe513b09e7322b67fb53399bec130d747
--- a/src/pz_save_manager/watcher.py
