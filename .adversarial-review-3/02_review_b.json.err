   328	def _need(data: dict | None, *keys: str):
   329	    """Return (data, None) if all keys present, else (None, error_response)."""
   330	    if not isinstance(data, dict) or not all(k in data and data[k] for k in keys):
   331	        return None, (jsonify({"ok": False, "error": f"Missing fields: {', '.join(keys)}"}), 400)
   332	    return data, None
   333	
   334	
   335	@app.route("/api/backup", methods=["POST"])
   336	def api_backup():
   337	    data, err = _need(request.get_json(silent=True), "game_mode", "save_name")
   338	    if err:
   339	        return err
   340	    try:
   341	        b = create_backup(data["game_mode"], data["save_name"])
   342	        return jsonify({"ok": True, "timestamp": b.timestamp})
   343	    except (SaveNotFound, BackupError) as e:
   344	        return jsonify({"ok": False, "error": str(e)}), 400
   345	
   346	
   347	@app.route("/api/restore", methods=["POST"])
   348	def api_restore():
   349	    data, err = _need(request.get_json(silent=True), "game_mode", "save_name", "timestamp")
   350	    if err:
   351	        return err
   352	    from contextlib import nullcontext
   353	    from .saves import get_save
   354	    manager = get_manager()
   355	    # If the target save is currently being watched, suppress watcher events
   356	    # while restore writes files in — otherwise the watcher would create an
   357	    # immediate auto-backup of the just-restored content.
   358	    try:
   359	        live_save = get_save(data["game_mode"], data["save_name"])
   360	        pause_ctx = manager.pause_for(live_save)

