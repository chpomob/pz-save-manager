   129	def _validate_name(value: str, label: str) -> None:
   130	    """Reject empty, path-traversal, IP-shaped, or otherwise dangerous names."""
   131	    if not value or not value.strip():
   132	        raise SaveManagerError(f"{label} cannot be empty")
   133	    if ".." in value or "/" in value or "\\" in value or "\x00" in value:
   134	        raise SaveManagerError(f"Invalid {label}: {value!r}")
   135	    if _is_multiplayer(value.strip()):
   136	        raise SaveManagerError(f"{label} looks like a server address: {value!r}")
   137	    if not _SANE_NAME_RE.match(value):
   138	        raise SaveManagerError(f"Invalid characters in {label}: {value!r}")
   139	    if len(value.strip()) > 200:
   140	        raise SaveManagerError(f"{label} is too long (max 200 characters)")
