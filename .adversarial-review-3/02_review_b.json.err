    22	def parse_mods(save_path: Path) -> list[str] | None:
    23	    """Return list of active mod IDs, or None."""
    24	    path = save_path / "mods.txt"
    25	    if not path.is_file():
    26	        return None
    27	    try:
    28	        text = path.read_text(encoding="utf-8", errors="replace")
    29	    except OSError:
    30	        return None
    31	    # Extract quoted mod names from mods {} block
    32	    mods = re.findall(r'"([^"]+)"', text)
    33	    return mods if mods else []
