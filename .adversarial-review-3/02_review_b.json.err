     1	"""One-command installer — creates launchers, desktop shortcuts, auto-start."""
     2	
     3	from __future__ import annotations
     4	
     5	import os
     6	import platform
     7	import shutil
     8	import sys
     9	from pathlib import Path
    10	
    11	
    12	PROJECT_DIR = Path(__file__).resolve().parent.parent
    13	ICON = "🧟"
    14	
    15	
    16	def install_linux() -> None:
    17	    """Create .desktop entry for Linux app menus."""
    18	    desktop_dir = Path.home() / ".local" / "share" / "applications"
    19	    desktop_dir.mkdir(parents=True, exist_ok=True)
    20	
    21	    desktop_file = desktop_dir / "pz-save-manager.desktop"
    22	    launcher = PROJECT_DIR / "launcher.sh"
    23	
    24	    desktop_file.write_text(f"""[Desktop Entry]
    25	Name=PZ Save Manager
    26	Comment=Backup manager for Project Zomboid
    27	Exec={launcher}
    28	Icon=utilities-terminal
    29	Terminal=true
    30	Type=Application
    31	Categories=Game;Utility;
    32	""")
    33	    os.chmod(desktop_file, 0o755)
    34	    print(f"  ✓ Desktop entry: {desktop_file}")
    35	
    36	
    37	def install_windows() -> None:
    38	    """Create Start Menu shortcut for Windows."""
    39	    import pythoncom
    40	    from win32com.client import Dispatch
    41	
    42	    startup = Path(os.environ["APPDATA"]) / "Microsoft" / "Windows" / "Start Menu" / "Programs"
    43	    shortcut_path = startup / "PZ Save Manager.lnk"
    44	
    45	    shell = Dispatch("WScript.Shell")
    46	    shortcut = shell.CreateShortcut(str(shortcut_path))
    47	    shortcut.TargetPath = str(PROJECT_DIR / "launcher.bat")
    48	    shortcut.WorkingDirectory = str(PROJECT_DIR)
    49	    shortcut.IconLocation = "shell32.dll,13"
    50	    shortcut.Save()
    51	    print(f"  ✓ Start Menu shortcut: {shortcut_path}")
    52	
    53	
    54	def install() -> None:
    55	    """Create launchers and desktop shortcuts."""
    56	    print(f"\n  {ICON} Installing PZ Save Manager...\n")
    57	
    58	    system = platform.system()
    59	    if system == "Linux":
    60	        install_linux()
    61	    elif system == "Windows":
    62	        install_windows()
    63	    elif system == "Darwin":
    64	        print("  macOS: double-click launcher.sh")
    65	    else:
    66	        print(f"  Unknown OS: {system} — use launcher.sh directly")
    67	
    68	    print(f"\n  Done! Launch with: {PROJECT_DIR}/launcher.{'bat' if system == 'Windows' else 'sh'}\n")
    69	
    70	
    71	if __name__ == "__main__":
    72	    install()

