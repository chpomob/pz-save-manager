   143	def rename_save(
   144	    game_mode: str,
   145	    old_name: str,
   146	    new_name: str,
   147	    *,
   148	    saves_root: Path | str | None = None,
   149	) -> SaveGame:
   150	    """Rename a save directory. Raises SaveManagerError on invalid names or conflicts."""
   151	    _validate_name(game_mode, "game_mode")
   152	    _validate_name(old_name, "old_name")
   153	    _validate_name(new_name, "new_name")
   154	
   155	    old = get_save(game_mode, old_name, saves_root=saves_root)
   156	    root = _to_root(saves_root)
   157	    new_path = root / game_mode / new_name.strip()
   158	    if new_path.exists():
   159	        raise SaveManagerError(f"Cannot rename save to {new_name!r}: Destination already exists: {new_name!r}")
