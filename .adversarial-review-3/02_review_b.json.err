   377	def prune_auto_backups(
   378	    game_mode: str,
   379	    save_name: str,
   380	    max_count: int,
   381	    *,
   382	    backups_root: Path | str | None = None,
   383	) -> int:
   384	    """Delete the oldest auto-backups so at most `max_count` remain.
   385	
   386	    Manual backups (no .pz-auto marker) are never deleted.  Returns the
   387	    number of auto-backups removed.
   388	    """
   389	    if max_count <= 0:
   390	        return 0
   391	    root = _root(backups_root, get_backups_root())
   392	    save_dir = root / game_mode / save_name
   393	    if not save_dir.is_dir():
   394	        return 0
   395	
   396	    # Collect auto-backup directories with their timestamps
   397	    autos: list[tuple[str, Path]] = []
   398	    for item in save_dir.iterdir():
   399	        if item.is_dir() and (item / _AUTO_FILE).is_file():
   400	            autos.append((item.name, item))
   401	
   402	    if len(autos) <= max_count:
   403	        return 0
   404	
   405	    # Sort by timestamp (oldest first) so we delete the oldest
   406	    autos.sort(key=lambda x: x[0])
   407	    to_delete = autos[: len(autos) - max_count]
   408	
   409	    removed = 0
   410	    for _, path in to_delete:
   411	        try:
   412	            shutil.rmtree(path)
   413	            removed += 1
   414	        except OSError:
   415	            pass
   416	    return removed

