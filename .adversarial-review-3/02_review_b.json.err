    49	            if self._timer is not None:
    50	                self._timer.cancel()
    51	                self._timer = None
    52	
    53	    def cancel_pending(self) -> None:
    54	        """Cancel any pending debounce backup."""
    55	        with self._lock:
    56	            if self._timer is not None:
    57	                self._timer.cancel()
    58	                self._timer = None
    59	
    60	    def resume(self, grace_seconds: float = 1.0) -> None:
    61	        """Re-enable events, with a short grace window for in-flight
    62	        watchdog events from the paused operation to drain."""
    63	        with self._lock:
    64	            self._ignore_until = time.time() + grace_seconds
    65	
    66	    def on_modified(self, event) -> None:
