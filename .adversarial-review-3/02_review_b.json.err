    98	
    99	def _should_skip(name: str) -> bool:
   100	    """Return True for auto-generated saves that should be hidden.
   101	    
   102	    Excludes:
   103	    - Multiplayer saves (IP-prefixed or _player suffix)
   104	    - Crash-recovery auto-saves (_crash suffix)
   105	    """
   106	    return (
   107	        _MULTIPLAYER_RE.match(name)
   108	        or _MP_PLAYER_SUFFIX_RE.search(name)
   109	        or _CRASH_SUFFIX_RE.search(name)
   110	    )
