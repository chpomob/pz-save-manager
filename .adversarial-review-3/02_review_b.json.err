   113	def get_save(game_mode: str, save_name: str, saves_root: Path | str | None = None) -> SaveGame:
   114	    """Return a specific save or raise SaveNotFound."""
   115	    # P0: prevent path traversal — reject '..', '/', '\\' and null bytes in components
   116	    for val, label in ((game_mode, "game_mode"), (save_name, "save_name")):
   117	        if ".." in val or "/" in val or "\\" in val or "\x00" in val:
   118	            raise SaveNotFound(f"Invalid {label}: {val!r}")
   119	    root = _to_root(saves_root)
   120	    path = root / game_mode / save_name
   121	    if not path.is_dir():
   122	        raise SaveNotFound(f"Save not found: {game_mode}/{save_name}")
