    36	def _save(data: dict) -> None:
    37	    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    38	    # Atomic write: write to temp file in the same directory, then replace.
    39	    # This prevents corruption if the process is killed mid-write.
    40	    fd, tmp_path = tempfile.mkstemp(
    41	        suffix=".tmp", prefix=".config-", dir=str(CONFIG_FILE.parent)
    42	    )
    43	    try:
    44	        with os.fdopen(fd, "w", encoding="utf-8") as f:
    45	            json.dump(data, f, indent=2)
    46	        os.replace(tmp_path, CONFIG_FILE)
    47	    except Exception:
    48	        try:
    49	            os.unlink(tmp_path)
    50	        except OSError:
