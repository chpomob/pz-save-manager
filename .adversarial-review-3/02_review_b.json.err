    37	
    38	def map_name(save_path: Path) -> str | None:
    39	    """Extract visible map name from map_ver.bin (e.g. 'Rosewood, KY')."""
    40	    path = save_path / "map_ver.bin"
    41	    if not path.is_file():
    42	        return None
    43	    try:
    44	        data = path.read_bytes()
    45	        # The format is: 4 bytes version, 4 bytes flags, then UTF-16LE strings
    46	        # Look for the readable part (starts after ~8 bytes, UTF-16LE encoded)
    47	        # Decode from offset 8 as UTF-16LE, grab first null-terminated string
    48	        if len(data) > 12:
    49	            # Try parsing as UTF-16LE from byte 8
    50	            raw = data[8:]
    51	            try:
    52	                decoded = raw.decode("utf-16-le", errors="ignore")
    53	                # Take first line / null-terminated part
    54	                name = decoded.split("\x00")[0].strip()
    55	                if name and len(name) > 2 and len(name) < 100:
    56	                    return name
    57	            except Exception:
    58	                pass
    59	            # Fallback: extract ASCII-readable chars
    60	            readable = "".join(chr(b) for b in raw if 32 <= b < 127)
    61	            if readable and len(readable) > 2:
    62	                return readable[:80]
    63	    except Exception:
    64	        pass
