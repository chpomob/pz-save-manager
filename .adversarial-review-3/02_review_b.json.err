from jinja2 import Template
print(Template('{% if save.player_dead is none %}Unknown{% elif save.player_dead %}Dead{% else %}Alive{% endif %}').render(save={}))
print(Template('{% if save.player_x is not none %}Position ({{save.player_x}}, {{save.player_y}}){% endif %}').render(save={}))
