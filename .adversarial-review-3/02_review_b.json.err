    39	    def pause(self) -> None:
    40	        """Suppress all events until resume() is called.
    41	
    42	        Used during operations that legitimately rewrite the save dir
    43	        (e.g. restore_backup), so the watcher doesn't immediately back
    44	        up the just-restored content. Any pending debounce timer is
    45	        cancelled.
