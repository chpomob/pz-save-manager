   130	    ids = set()
   131	    for m in re.finditer(r"registryID\s*=\s*(\d+)", text):
   132	        ids.add(int(m.group(1)))
   133	    total = len(ids)
   134	
   135	    # Count vanilla items
   136	    vanilla = len(re.findall(r'existsAsVanilla\s*=\s*true', text, re.IGNORECASE))
   137	    # Count modded items
   138	    modded = len(re.findall(r'isModded\s*=\s*true', text, re.IGNORECASE))
   139	
   140	    return {"total": total, "vanilla": vanilla, "modded": modded}
   141	
   142	
   143	# ---- vehicles.db ----
   144	
   145	def count_vehicles(save_path: Path) -> int | None:
   146	    """Return the number of vehicles, or None if the DB can't be read."""
   147	    path = save_path / "vehicles.db"
   148	    if not path.is_file():
   149	        return None
   150	    try:
   151	        with sqlite3.connect(f"file:{path}?mode=ro", uri=True) as conn:
   152	            cur = conn.execute("SELECT COUNT(*) FROM vehicles")
   153	            count = cur.fetchone()[0]
   154	        return count
   155	    except Exception:
   156	        return None
   157	
   158	
   159	# ---- players.db ----
   160	
   161	def count_players(save_path: Path) -> int | None:
   162	    """Return the number of players (multiplayer), or None."""
   163	    path = save_path / "players.db"
   164	    if not path.is_file() or path.stat().st_size == 0:
   165	        return None
   166	    try:
   167	        with sqlite3.connect(f"file:{path}?mode=ro", uri=True) as conn:
   168	            tables = [r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")]
   169	            if "players" in tables:
   170	                cur = conn.execute("SELECT COUNT(*) FROM players")
   171	                count = cur.fetchone()[0]
   172	                return count
   173	        return None
   174	    except Exception:
   175	        return None
   176	
   177	
   178	# ---- InGameMap.ini ----
   179	
   180	def map_position(save_path: Path) -> dict | None:
   181	    """Extract map center coordinates, or None."""
   182	    path = save_path / "InGameMap.ini"
   183	    if not path.is_file():
   184	        return None
   185	    try:
   186	        text = path.read_text(encoding="utf-8", errors="replace")
   187	    except OSError:
   188	        return None
   189	    cx = re.search(r"WorldMap\.CenterX=([\d.]+)", text)
   190	    cy = re.search(r"WorldMap\.CenterY=([\d.]+)", text)
   191	    zoom = re.search(r"WorldMap\.Zoom=([\d.]+)", text)
   192	    if cx and cy:
   193	        return {
   194	            "x": int(float(cx.group(1))),
   195	            "y": int(float(cy.group(1))),
   196	            "zoom": float(zoom.group(1)) if zoom else 18.0,
   197	        }
   198	    return None
   199	
   200	
   201	# ---- Aggregate ----
   202	
   203	def extract_all(save_path: Path) -> dict:
   204	    """Return all safely-extractable metadata for a save directory."""
   205	    info: dict = {}
   206	    info["has_thumbnail"] = has_thumbnail(save_path)
   207	
   208	    mn = map_name(save_path)
   209	    if mn:
   210	        info["map_name"] = mn
   211	
   212	    pn = player_info(save_path)
   213	    if pn:
   214	        info["player"] = pn["name"]
   215	        info["player_dead"] = pn["is_dead"]
   216	        info["player_x"] = pn["x"]
   217	        info["player_y"] = pn["y"]
   218	        info["player_world_version"] = pn["world_version"]
   219	
   220	    mods = parse_mods(save_path)
   221	    if mods is not None:
   222	        info["mods"] = mods
   223	        info["mod_count"] = len(mods)
   224	
   225	    # crafted_objects and parse_world_dictionary read multi-megabyte .lua
   226	    # files; their output isn't displayed anywhere in the GUI. Skipped on
   227	    # the hot path. Call those functions directly if you need the data.
   228	
   229	    v = count_vehicles(save_path)
   230	    if v is not None:
   231	        info["vehicles"] = v
   232	
   233	    p = count_players(save_path)
   234	    if p is not None:
   235	        info["players"] = p
   236	
   237	    pos = map_position(save_path)
   238	    if pos:
   239	        info["map_x"] = pos["x"]
   240	        info["map_y"] = pos["y"]
   241	        info["map_zoom"] = pos["zoom"]
   242	
   243	    return info
   244	
   245	
   246	# ── World version → Build mapping ─────────────────────────────────────
   247	#
   248	# The world version is bumped by the PZ devs whenever the save-file format
   249	# changes.  It does NOT change on every patch, so multiple minor builds
   250	# share the same world version.  The breakpoints below are from community
   251	# knowledge and the pzdataspec project.
   252	
   253	# fmt: off
   254	_WORLD_VERSION_BUILD: list[tuple[range, str]] = [
   255	    (range(0,   160),   "Build 40 or earlier"),
   256	    (range(160, 196),   "Build 41"),
   257	    (range(196, 210),   "Build 41 (late)"),
   258	    (range(210, 241),   "Build 41/42 transition"),
   259	    (range(241, 246),   "Build 42 (early)"),
   260	    (range(246, 300),   "Build 42"),

