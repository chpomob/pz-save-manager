    55	def list_game_modes(saves_root: Path | str | None = None) -> list[str]:
    56	    """List available game mode directories."""
    57	    root = _to_root(saves_root)
    58	    if not root.is_dir():
    59	        return []
    60	    return sorted(
    61	        (path.name for path in root.iterdir() if path.is_dir() and not path.name.startswith(".")),
    62	        key=str.casefold,
    63	    )
