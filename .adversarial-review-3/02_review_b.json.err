   232	        raise BackupError("A game mode is required when filtering by save name")
   233	    root = _root(backups_root, get_backups_root())
   234	    if not root.is_dir():
   235	        return []
   236	    records: list[BackupRecord] = []
   237	    mode_dirs = [root / game_mode] if game_mode else [path for path in root.iterdir() if path.is_dir()]
   238	    for mode_dir in mode_dirs:
   239	        if not mode_dir.is_dir():
   240	            continue
   241	        save_dirs = [mode_dir / save_name] if save_name else [path for path in mode_dir.iterdir() if path.is_dir()]
   242	        for save_dir in save_dirs:
   243	            if not save_dir.is_dir():
   244	                continue
   245	            for backup_dir in save_dir.iterdir():
   246	                if backup_dir.is_dir():
   247	                    auto = (backup_dir / _AUTO_FILE).is_file()
   248	                    records.append(BackupRecord(mode_dir.name, save_dir.name, backup_dir.name, backup_dir, auto=auto))
   249	    return sorted(
   250	        records,
   251	        key=lambda backup: (backup.game_mode.casefold(), backup.save_name.casefold(), backup.timestamp),
   252	        reverse=True,
   253	    )
