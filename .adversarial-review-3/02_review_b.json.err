   199	
   200	def _save_info(save: SaveGame, manager: WatcherManager) -> dict:
   201	    path = save.path
   202	    modified = datetime.fromtimestamp(get_save_modified_time(save)).strftime("%Y-%m-%d %H:%M")
   203	    backups = list_backups(save.game_mode, save.name)
   204	    extra = extract_all(path)
   205	    info = {
   206	        "game_mode": save.game_mode, "name": save.name, "full_name": save.name,
   207	        "modified": modified,
   208	        "has_thumbnail": extra.get("has_thumbnail", False),
   209	        "backups": [{"game_mode": b.game_mode, "save_name": b.save_name,
   210	            "timestamp": b.timestamp, "auto": b.auto, "age": b.age, "formatted": b.formatted,
   211	        } for b in backups[:5]],
   212	        "watched": save.display_name in manager.watched_saves(),
   213	    }
   214	    for k in ("players", "map_pos", "mod_count",
   215	              "player", "player_dead", "player_x", "player_y", "player_world_version"):
   216	        if k in extra:
   217	            info[k] = extra[k]
   218	    return info
   219	
   220	
   221	@app.route("/")
   222	def index():
   223	    try:
   224	        manager = get_manager()
   225	        saves = list_saves()
