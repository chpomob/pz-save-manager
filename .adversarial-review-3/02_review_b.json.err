    66	def list_saves(saves_root: Path | str | None = None) -> list[SaveGame]:
    67	    """Discover saves under Saves/GameMode/SaveName."""
    68	    root = _to_root(saves_root)
    69	    if not root.is_dir():
    70	        return []
    71	
    72	    saves: list[SaveGame] = []
    73	    for mode_dir in root.iterdir():
    74	        if not mode_dir.is_dir() or mode_dir.name.startswith("."):
    75	            continue
    76	        for save_dir in mode_dir.iterdir():
    77	            if save_dir.is_dir() and not save_dir.name.startswith("."):
    78	                if not _should_skip(save_dir.name):
    79	                    saves.append(SaveGame(mode_dir.name, save_dir.name, save_dir))
    80	
    81	    # Most recently modified first; tied saves fall back to alphabetical order.
    82	    return sorted(saves, key=lambda save: (-get_save_modified_time(save),
    83	                                             save.game_mode.casefold(),
    84	                                             save.name.casefold()))
