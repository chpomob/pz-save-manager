    36	def get_save_modified_time(save: SaveGame) -> float:
    37	    """Return a representative modification time for the save (fast, no rglob).
    38	
    39	    A full rglob is O(files) — PZ saves contain thousands of map chunks, and
    40	    on Windows with real-time AV, walking the tree can take minutes per save.
    41	    Sampling the save dir + the files PZ actually writes to is O(1) and gives
    42	    the same answer for any normal play session.
    43	    """
    44	    latest = save.path.stat().st_mtime
    45	    for name in ("sandbox.lua", "players.db", "vehicles.db", "map_ver.bin", "map"):
    46	        try:
    47	            t = (save.path / name).stat().st_mtime
    48	            if t > latest:
    49	                latest = t
    50	        except OSError:
    51	            continue
    52	    return latest
    53	
