   356	    _validate_component(old_save_name, "old save name")
   357	    _validate_component(new_save_name, "new save name")
   358	
   359	    root = _root(backups_root, get_backups_root())
   360	    old_dir = root / game_mode / old_save_name
   361	    new_dir = root / game_mode / new_save_name
   362	
   363	    if not old_dir.is_dir():
   364	        return 0
   365	
   366	    # Count backups before moving
   367	    count = sum(1 for _ in old_dir.iterdir() if _.is_dir())
   368	    try:
   369	        old_dir.rename(new_dir)
