    except (SaveManagerError, BackupError) as exc:
        raise click.ClickException(str(exc)) from exc
    console.print(f"[green]Saved renamed to[/green] {new_save.name}")
    if n:
        console.print(f"[dim]{n} backup(s) moved[/dim]")


