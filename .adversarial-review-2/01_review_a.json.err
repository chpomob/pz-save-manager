    33	        self._lock = threading.Lock()
    34	        self._backups: list[BackupRecord] = []
    35	        self._ignore_until = 0.0  # epoch seconds; events before this are dropped
    36	        self._last_backup_time = 0.0  # epoch seconds of last auto-backup
    37	        self._last_backup_mtime = 0.0  # save mtime at time of last backup
    38	
    39	    def pause(self) -> None:
    40	        """Suppress all events until resume() is called.
    41	
    42	        Used during operations that legitimately rewrite the save dir
    43	        (e.g. restore_backup), so the watcher doesn't immediately back
    44	        up the just-restored content. Any pending debounce timer is
    45	        cancelled.
    46	        """
    47	        with self._lock:
    48	            self._ignore_until = float("inf")
    49	            if self._timer is not None:
    50	                self._timer.cancel()
    51	                self._timer = None
    52	
    53	    def cancel_pending(self) -> None:
    54	        """Cancel any pending debounce backup."""
    55	        with self._lock:
    56	            if self._timer is not None:
    57	                self._timer.cancel()
    58	                self._timer = None
    59	
    60	    def resume(self, grace_seconds: float = 1.0) -> None:
    61	        """Re-enable events, with a short grace window for in-flight
    62	        watchdog events from the paused operation to drain."""
    63	        with self._lock:
    64	            self._ignore_until = time.time() + grace_seconds
