<button class="btn btn-sm" style="background:var(--accent2);color:var(--text)" onclick='event.stopPropagation();annotate({{b.game_mode|tojson}},{{b.real_save_name|tojson}},{{b.timestamp|tojson}},this)'>📝 Note</button>
