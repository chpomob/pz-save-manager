   114	class WatcherManager:
   115	    """Manages multiple SaveWatcher instances."""
   116	
   117	    def __init__(self) -> None:
   118	        self._observer = Observer()
   119	        self._watchers: dict[str, SaveWatcher] = {}
   120	        self._watches: dict[str, object] = {}  # watchdog handles
   121	        self._running = False
   122	
   123	    @property
   124	    def running(self) -> bool:
   125	        return self._running
   126	
   127	    def start(self) -> None:
   128	        if not self._running:
   129	            if not self._observer.is_alive():
   130	                self._observer = Observer()
   131	                # Re-schedule all watched saves
   132	                for key, watcher in list(self._watchers.items()):
   133	                    save = watcher.save
   134	                    handle = self._observer.schedule(watcher, str(save.path), recursive=True)
   135	                    self._watches[key] = handle
   136	            self._observer.start()
   137	            self._running = True
   138	
   139	    def stop(self) -> None:
   140	        for watcher in list(self._watchers.values()):
   141	            watcher.cancel_pending()
   142	        if self._running:
   143	            self._observer.stop()
   144	            self._observer.join(timeout=5)
   145	            self._running = False
   146	
   147	    def watch(self, save: SaveGame, debounce_seconds: float = 5.0, backup_cooldown_seconds: float = 300.0) -> SaveWatcher:
   148	        key = save.display_name
   149	        if key in self._watchers:
   150	            return self._watchers[key]
   151	        watcher = SaveWatcher(save, debounce_seconds, backup_cooldown_seconds)
   152	        self._watchers[key] = watcher
   153	        handle = self._observer.schedule(watcher, str(save.path), recursive=True)
   154	        self._watches[key] = handle
   155	        return watcher
   156	
   157	    def unwatch(self, save: SaveGame) -> None:
   158	        key = save.display_name
   159	        if key in self._watches:
   160	            self._observer.unschedule(self._watches[key])
   161	            del self._watches[key]
   162	        if key in self._watchers:
   163	            watcher = self._watchers.pop(key)
   164	            watcher.cancel_pending()
   165	
   166	    def watched_saves(self) -> list[str]:
   167	        return sorted(self._watchers.keys())
   168	
   169	    def get_backups(self, save: SaveGame) -> list[BackupRecord]:
   170	        key = save.display_name
   171	        if key in self._watchers:
   172	            return list(self._watchers[key]._backups)
   173	        return []
   174	
   175	    @contextmanager
   176	    def pause_for(self, save: SaveGame):
   177	        """Context manager: temporarily silence the watcher for `save`.
   178	
   179	        No-op if the save isn't being watched. After the block exits,
   180	        the watcher resumes with a short grace window so any file
   181	        events still in watchdog's queue from the operation get dropped
   182	        instead of triggering an immediate auto-backup.
   183	        """
   184	        watcher = self._watchers.get(save.display_name)
   185	        if watcher is not None:
   186	            watcher.pause()
   187	        try:
   188	            yield
   189	        finally:
   190	            if watcher is not None:
   191	                watcher.resume()
   192	
   193	
   194	# Global instance
   195	_manager: WatcherManager | None = None
   196	
   197	
   198	def get_manager() -> WatcherManager:
   199	    global _manager
   200	    if _manager is None:
   201	        _manager = WatcherManager()
   202	    return _manager

