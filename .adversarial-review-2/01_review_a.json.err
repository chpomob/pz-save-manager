   514	@app.route("/api/shutdown", methods=["POST"])
   515	def api_shutdown():
   516	    """Gracefully stop the server."""
   517	    manager = get_manager()
   518	    if manager.running:
   519	        manager.stop()
   520	
   521	    # Capture the Werkzeug shutdown function while we're still inside the
   522	    # Flask request context.  The Timer callback runs in a different thread
   523	    # where flask.request (a thread-local proxy) is empty.
   524	    shutdown_func = request.environ.get("werkzeug.server.shutdown")
   525	
   526	    def _shutdown() -> None:
   527	        import os
   528	        import sys
   529	        if shutdown_func is not None:
   530	            try:
   531	                shutdown_func()
   532	                return
   533	            except Exception:
   534	                pass
   535	        # sys.exit only kills the request thread, not the main process.
   536	        # Try it anyway (works in some WSGI servers), but fall back to
   537	        # os._exit as last resort. The 3-second delay ensures the HTTP
   538	        # response has time to flush before the process dies.
   539	        try:
   540	            sys.exit(0)
   541	        except SystemExit:
   542	            pass
   543	        os._exit(0)
   544	
   545	    from threading import Timer
   546	    Timer(3.0, _shutdown).start()
   547	    return jsonify({"ok": True, "message": "Shutting down..."})
