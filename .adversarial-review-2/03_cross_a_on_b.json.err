from watchdog.observers import Observer
from watchdog.events import FileSystemEventHandler
from pathlib import Path
import tempfile
with tempfile.TemporaryDirectory() as d:
    o=Observer()
    h=FileSystemEventHandler()
    print('fresh alive', o.is_alive())
    try:
        w=o.schedule(h,d,recursive=True)
        print('schedule fresh ok', w)
    except Exception as e:
        print('schedule fresh err', type(e).__name__, e)
    o.start(); o.stop(); o.join()
    print('stopped alive', o.is_alive())
    try:
        w=o.schedule(h,d,recursive=True)
        print('schedule stopped ok', w)
    except Exception as e:
        print('schedule stopped err', type(e).__name__, e)
